{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": false
    },

    "planos": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".write": false,
      "$personalId": {
        ".read": "auth != null && (auth.uid === $personalId || root.child('admins/'+auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
      }
    },

    "adminLogs": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".indexOn": ["targetPersonalId"]
    },

    "users": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users/'+$uid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users/'+$uid+'/personalId').val() === auth.uid)"
      }
    },

    "codigos": {
      "$codigo": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "cpfs": {
      "$cpf": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('personalId').val() === auth.uid)"
      }
    },

    "linksFicha": {
      "$codigo": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('personalId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['personalId', 'nome'])"
      }
    },

    "fichas": {
      "$personalId": {
        ".read": "auth != null && auth.uid === $personalId",
        "$fichaId": {
          ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.uid === $personalId)",
          ".validate": "newData.hasChildren(['respostas', 'ts'])"
        }
      }
    },

    "feedbacks": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "suplementos": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)"
      }
    },

    "suplementosTomados": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "anexos": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && root.child('users/'+$alunoUid+'/personalId').val() === auth.uid"
      }
    },

    "anexosDados": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && root.child('users/'+$alunoUid+'/personalId').val() === auth.uid"
      }
    },

    "diario": {
      "$alunoUid": {
        ".read": "auth != null && auth.uid === $alunoUid",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "diarioCompartilhado": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "personals": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "codigoFicha": { ".read": true }
      }
    },

    "treinos": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)"
      }
    },

    "treinosHistorico": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)"
      }
    },

    "execucoes": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "avaliacoes": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && root.child('users/'+$alunoUid+'/personalId').val() === auth.uid"
      }
    },

    "fotosProgresso": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && root.child('users/'+$alunoUid+'/personalId').val() === auth.uid"
      }
    },

    "cobrancas": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        "$cobrancaId": {
          ".write": "auth != null && (root.child('users/'+$alunoUid+'/personalId').val() === auth.uid || (auth.uid === $alunoUid && data.exists() && newData.exists() && (data.child('status').val() === 'pendente' || data.child('status').val() === 'recusado') && newData.child('status').val() === 'em_analise'))",
          ".validate": "!newData.exists() || newData.hasChildren(['valor', 'vencimento', 'status'])",
          "valor": {
            ".validate": "newData.isNumber() && newData.val() > 0 && (root.child('users/'+$alunoUid+'/personalId').val() === auth.uid || !data.exists() || newData.val() === data.val())"
          },
          "vencimento": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && (root.child('users/'+$alunoUid+'/personalId').val() === auth.uid || !data.exists() || newData.val() === data.val())"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(pendente|em_analise|pago|recusado)$/)"
          },
          "tipo": {
            ".validate": "newData.isString() && (root.child('users/'+$alunoUid+'/personalId').val() === auth.uid || !data.exists() || newData.val() === data.val())"
          },
          "personalId": {
            ".validate": "newData.isString() && (root.child('users/'+$alunoUid+'/personalId').val() === auth.uid || !data.exists() || newData.val() === data.val())"
          },
          "criadaEm": {
            ".validate": "newData.isNumber() && (root.child('users/'+$alunoUid+'/personalId').val() === auth.uid || !data.exists() || newData.val() === data.val())"
          },
          "validadaEm": {
            ".validate": "root.child('users/'+$alunoUid+'/personalId').val() === auth.uid && newData.isNumber()"
          },
          "validadaPor": {
            ".validate": "root.child('users/'+$alunoUid+'/personalId').val() === auth.uid && newData.val() === auth.uid"
          },
          "motivoRecusa": {
            ".validate": "root.child('users/'+$alunoUid+'/personalId').val() === auth.uid && newData.isString() && newData.val().length <= 300"
          },
          "pagamento": {
            ".validate": "newData.hasChild('data')",
            "data": {
              ".validate": "newData.isNumber()"
            },
            "obs": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "comprovante": {
              ".validate": "newData.isString() && newData.val().length <= 700"
            },
            "$outro": {
              ".validate": false
            }
          },
          "$outroCampo": {
            ".validate": false
          }
        }
      }
    },

    "presenca": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "chats": {
      "$conversaId": {
        ".read": "auth != null && $conversaId.contains(auth.uid)",
        ".write": "auth != null && $conversaId.contains(auth.uid)"
      }
    },

    "notificacoes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    }
  }
}
