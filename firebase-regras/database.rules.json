{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": false
    },

    "planos": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".write": false,
      "$personalId": {
        ".read": "auth != null && (auth.uid === $personalId || root.child('admins/'+auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins/'+auth.uid).val() === true"
      }
    },

    "adminLogs": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/'+auth.uid).val() === true",
      ".indexOn": ["targetPersonalId"]
    },

    "users": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users/'+$uid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users/'+$uid+'/personalId').val() === auth.uid)"
      }
    },

    "codigos": {
      "$codigo": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "cpfs": {
      "$cpf": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('personalId').val() === auth.uid)"
      }
    },

    "linksFicha": {
      "$codigo": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('personalId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['personalId', 'nome'])"
      }
    },

    "fichas": {
      "$personalId": {
        ".read": "auth != null && auth.uid === $personalId",
        "$fichaId": {
          ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.uid === $personalId)",
          ".validate": "newData.hasChildren(['respostas', 'ts'])"
        }
      }
    },

    "feedbacks": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "suplementos": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)"
      }
    },

    "suplementosTomados": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "anexos": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && root.child('users/'+$alunoUid+'/personalId').val() === auth.uid"
      }
    },

    "anexosDados": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && root.child('users/'+$alunoUid+'/personalId').val() === auth.uid"
      }
    },

    "diario": {
      "$alunoUid": {
        ".read": "auth != null && auth.uid === $alunoUid",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "diarioCompartilhado": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "personals": {
      ".read": "auth != null && root.child('admins/'+auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "codigoFicha": { ".read": true }
      }
    },

    "treinos": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)"
      }
    },

    "treinosHistorico": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)"
      }
    },

    "execucoes": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $alunoUid"
      }
    },

    "avaliacoes": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && root.child('users/'+$alunoUid+'/personalId').val() === auth.uid"
      }
    },

    "fotosProgresso": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && root.child('users/'+$alunoUid+'/personalId').val() === auth.uid"
      }
    },

    "cobrancas": {
      "$alunoUid": {
        ".read": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $alunoUid || root.child('users/'+$alunoUid+'/personalId').val() === auth.uid)"
      }
    },

    "presenca": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "chats": {
      "$conversaId": {
        ".read": "auth != null && $conversaId.contains(auth.uid)",
        ".write": "auth != null && $conversaId.contains(auth.uid)"
      }
    },

    "notificacoes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    }
  }
}
